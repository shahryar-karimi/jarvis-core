# Docker image metadata. Set the exact reviewed release tag and commit before
# Compose validation; an empty JARVIS_VCS_REF intentionally fails preflight.
JARVIS_IMAGE_TAG=v0.1.0
JARVIS_VCS_REF=
JARVIS_ENV_FILE=.env.production

# Caddy. JARVIS_DOMAIN must be a hostname without a scheme or path, and its
# public DNS record must resolve to this server.
JARVIS_DOMAIN=core.example.com
CADDY_ACME_EMAIL=ops@example.com

# PostgreSQL bootstrap administrator. Core never uses this account directly.
POSTGRES_DB=jarvis
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-me

# Least-privilege application/migration role. Generate a different URL-safe
# password and use the same value in JARVIS_DB_PASSWORD and the URL below.
JARVIS_DB_USER=jarvis_app
JARVIS_DB_PASSWORD=replace-me
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis_app:replace-me@postgres:5432/jarvis

# Application identity and browser access. Keep CORS empty when no browser
# frontend calls Core directly; otherwise list only exact HTTPS origins.
JARVIS_ENVIRONMENT=production
JARVIS_ASSISTANT_NAME=JARVIS
JARVIS_USER_NAME=
JARVIS_CORS_ORIGINS=[]
JARVIS_TRUSTED_HOSTS=["core.example.com","localhost","127.0.0.1","core"]
JARVIS_DOCS_ENABLED=false

# AI provider. Verify that the provider and selected model are available from
# the VPS region before deployment.
JARVIS_AI_PROVIDER=gemini
JARVIS_GEMINI_API_KEY=replace-me
JARVIS_GEMINI_MODEL=gemini-3.6-flash

# Generate a different random value for every secret below. Bearer tokens must
# have at least 32 ASCII characters; the digest key must have at least 32 bytes.
# Never reuse either PostgreSQL password or the Gemini key.
JARVIS_OWNER_TOKEN=replace-with-a-random-secret
JARVIS_DEVICE_ADMIN_TOKEN=replace-with-a-random-secret
JARVIS_DEVICE_CREDENTIAL_DIGEST_KEY=replace-with-a-random-secret

# Device gateway limits.
JARVIS_DEVICE_PAIRING_TTL_SECONDS=300
JARVIS_DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
JARVIS_DEVICE_COMMAND_TIMEOUT_SECONDS=30
JARVIS_DEVICE_MAX_MESSAGE_BYTES=65536
