JARVIS_ENVIRONMENT=development
JARVIS_ASSISTANT_NAME=JARVIS
JARVIS_USER_NAME=
JARVIS_DATABASE_URL=postgresql+asyncpg://jarvis:jarvis@localhost:5433/jarvis
JARVIS_AI_PROVIDER=gemini
JARVIS_GEMINI_API_KEY=replace-me
JARVIS_GEMINI_MODEL=gemini-3.6-flash
JARVIS_CORS_ORIGINS=["http://localhost:5173"]

# Required for operator-only device pairing and command endpoints. Generate a
# local value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_DEVICE_ADMIN_TOKEN=replace-with-a-random-secret
JARVIS_DEVICE_PAIRING_TTL_SECONDS=300
JARVIS_DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
JARVIS_DEVICE_COMMAND_TIMEOUT_SECONDS=30
JARVIS_DEVICE_MAX_MESSAGE_BYTES=65536

# External tests are disabled by default because they use live services.
RUN_DB_TESTS=0
RUN_LIVE_AI_TESTS=0
